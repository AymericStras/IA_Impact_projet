# Setup and registration links: docs/API-KEYS.md. Never commit actual key values.
# Copy to .env and fill locally. sync/doctor/serve read it; environment variables take priority.
# The station lookup (INTEGRATION.md) reads the same two names from the process environment.
DATATOURISME_API_KEY=
# Only oa_pk_ public keys are accepted; no account-secret or legacy keys.
OPENAGENDA_PUBLIC_KEY=
