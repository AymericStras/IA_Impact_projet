  "components": {
    "schemas": {
      "Activity": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "start": {
            "type": "string",
            "title": "Start",
            "description": "Local ISO date-time with offset"
          },
          "end": {
            "type": "string",
            "title": "End",
            "description": "Local ISO date-time with offset"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "description",
          "start",
          "end"
        ],
        "title": "Activity"
      },
      "Body_transcribe_audio_api_v1_conversations__conversation_id__audio_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_transcribe_audio_api_v1_conversations__conversation_id__audio_post"
      },
      "ClientConfig": {
        "properties": {
          "max_audio_seconds": {
            "type": "integer",
            "title": "Max Audio Seconds"
          },
          "max_audio_bytes": {
            "type": "integer",
            "title": "Max Audio Bytes"
          },
          "max_message_chars": {
            "type": "integer",
            "title": "Max Message Chars"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "planner_mode": {
            "type": "string",
            "enum": [
              "off",
              "simulated",
              "http"
            ],
            "title": "Planner Mode",
            "default": "off"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "max_audio_seconds",
          "max_audio_bytes",
          "max_message_chars",
          "timezone"
        ],
        "title": "ClientConfig"
      },
      "CompleteRequirements": {
        "properties": {
          "participants_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Participants Count"
          },
          "participants_breakdown": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ParticipantsBreakdown"
              },
              {
                "type": "null"
              }
            ]
          },
          "departure": {
            "$ref": "#/components/schemas/DateTimeRequirement"
          },
          "return": {
            "$ref": "#/components/schemas/DateTimeRequirement"
          },
          "teaching_type": {
            "$ref": "#/components/schemas/CompleteTeachingType"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "participants_count",
          "departure",
          "return",
          "teaching_type"
        ],
        "title": "CompleteRequirements"
      },
      "CompleteTeachingType": {
        "properties": {
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "theme": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject",
          "theme"
        ],
        "title": "CompleteTeachingType"
      },
      "ConfirmRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "ConfirmRequest"
      },
      "ConfirmedRequirements": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Conversation Id"
          },
          "status": {
            "type": "string",
            "const": "confirmed",
            "title": "Status",
            "default": "confirmed"
          },
          "timezone": {
            "type": "string",
            "const": "Europe/Paris",
            "title": "Timezone",
            "default": "Europe/Paris"
          },
          "confirmed_at": {
            "type": "string",
            "title": "Confirmed At",
            "description": "ISO 8601 timestamp with offset, e.g. 2026-10-10T14:32:05+02:00"
          },
          "requirements": {
            "$ref": "#/components/schemas/CompleteRequirements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "confirmed_at",
          "requirements"
        ],
        "title": "ConfirmedRequirements",
        "description": "Payload handed to the planning module after explicit confirmation."
      },
      "ConversationResponse": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "state": {
            "$ref": "#/components/schemas/ConversationState"
          },
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version",
            "description": "Monotonic version of the requirements; +1 for each applied patch"
          },
          "assistant_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assistant Message"
          },
          "requirements": {
            "$ref": "#/components/schemas/PartialRequirements"
          },
          "missing_fields": {
            "items": {
              "type": "string",
              "enum": [
                "participants_count",
                "departure",
                "return",
                "teaching_type"
              ]
            },
            "type": "array",
            "title": "Missing Fields"
          },
          "pending_clarification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingClarification"
              },
              {
                "type": "null"
              }
            ]
          },
          "ready_for_confirmation": {
            "type": "boolean",
            "title": "Ready For Confirmation"
          },
          "transcript": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript",
            "description": "Only after /audio: transcript to be corrected"
          },
          "confirmed_requirements": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfirmedRequirements"
              },
              {
                "type": "null"
              }
            ],
            "description": "Final payload, non-null only in the CONFIRMED state"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "state",
          "version",
          "assistant_message",
          "requirements",
          "missing_fields",
          "ready_for_confirmation",
          "messages"
        ],
        "title": "ConversationResponse",
        "description": "Response of all endpoints: the client renders it as is, without recomputing."
      },
      "ConversationState": {
        "type": "string",
        "enum": [
          "COLLECTING",
          "ASKING_USER",
          "AWAITING_CONFIRMATION",
          "EDITING",
          "CONFIRMED",
          "HANDOFF"
        ],
        "title": "ConversationState",
        "description": "States visible to the client. EXTRACTING/VALIDATING are internal to a request."
      },
      "CreateConversationRequest": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "CreateConversationRequest"
      },
      "DateTimeRequirement": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Time"
          },
          "constraint": {
            "$ref": "#/components/schemas/TimeConstraint"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "time",
          "constraint"
        ],
        "title": "DateTimeRequirement"
      },
      "EditRequirementRequest": {
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "participants_count",
              "departure",
              "return",
              "teaching_type"
            ],
            "title": "Field"
          },
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "$ref": "#/components/schemas/PartialDateTimePatch"
              },
              {
                "$ref": "#/components/schemas/TeachingTypePatch"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "value",
          "expected_version"
        ],
        "title": "EditRequirementRequest"
      },
      "HTTPValidationError": {
        "properties": {
