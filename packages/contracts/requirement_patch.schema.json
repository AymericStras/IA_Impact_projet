{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sncf-lio-chatbot/contracts/requirement_patch.schema.json",
  "description": "Structured output of the extraction model for one message; validated and merged by the backend.",
  "$defs": {
    "Ambiguity": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "participants_count",
            "departure_station",
            "departure",
            "return",
            "teaching_type"
          ],
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AmbiguityKind"
        },
        "detail": {
          "description": "Short English explanation for the dialogue manager; never shown to the user",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "field",
        "kind",
        "detail"
      ],
      "title": "Ambiguity",
      "type": "object"
    },
    "AmbiguityKind": {
      "enum": [
        "students_only",
        "relative_date_unresolved",
        "vague_quantity",
        "vague_time",
        "multiple_candidates",
        "unclear_subject",
        "other"
      ],
      "title": "AmbiguityKind",
      "type": "string"
    },
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "participants_count",
            "departure_station",
            "departure",
            "return",
            "teaching_type"
          ],
          "title": "Field",
          "type": "string"
        },
        "evidence": {
          "description": "Fragment that contradicts the current requirements without an explicit correction",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "field",
        "evidence"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "participants_count",
            "departure_station",
            "departure",
            "return",
            "teaching_type"
          ],
          "title": "Field",
          "type": "string"
        },
        "operation": {
          "description": "set = field was unknown; replace = explicit correction of a known value; clear = teacher withdraws a value",
          "enum": [
            "set",
            "replace",
            "clear"
          ],
          "title": "Operation",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PartialDateTimePatch"
            },
            {
              "$ref": "#/$defs/TeachingTypePatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "integer for participants_count; string (station or city name as said) for departure_station; date/time object for departure or return; subject/theme object for teaching_type; null for clear",
          "title": "Value"
        },
        "evidence": {
          "description": "Verbatim French fragment from the teacher's message supporting this operation",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "field",
        "operation",
        "value",
        "evidence"
      ],
      "title": "Operation",
      "type": "object"
    },
    "PartialDateTimePatch": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO date YYYY-MM-DD, or null when unknown/unresolved",
          "title": "Date"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "24h time HH:MM, or null",
          "title": "Time"
        },
        "constraint": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeConstraint"
            },
            {
              "type": "null"
            }
          ],
          "description": "exact | approximate | earliest | latest, or null"
        }
      },
      "required": [
        "date",
        "time",
        "constraint"
      ],
      "title": "PartialDateTimePatch",
      "type": "object"
    },
    "ParticipantsMentioned": {
      "additionalProperties": false,
      "properties": {
        "students": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of students mentioned in this message, or null",
          "title": "Students"
        },
        "accompanying": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of accompanying adults mentioned, or null",
          "title": "Accompanying"
        },
        "total_stated": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only when the teacher explicitly states a total ('nous sommes 30')",
          "title": "Total Stated"
        }
      },
      "required": [
        "students",
        "accompanying",
        "total_stated"
      ],
      "title": "ParticipantsMentioned",
      "type": "object"
    },
    "TeachingTypePatch": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Standard French school subject (Histoire, SVT, ...) or null",
          "title": "Subject"
        },
        "theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Teaching theme (Moyen Âge, architecture, ...) or null",
          "title": "Theme"
        }
      },
      "required": [
        "subject",
        "theme"
      ],
      "title": "TeachingTypePatch",
      "type": "object"
    },
    "TimeConstraint": {
      "description": "exact = « à 8 h »; approximate = « vers 8 h »; earliest = « après 8 h »; latest = « avant 17 h ».",
      "enum": [
        "exact",
        "approximate",
        "earliest",
        "latest"
      ],
      "title": "TimeConstraint",
      "type": "string"
    },
    "UserIntent": {
      "enum": [
        "provide_information",
        "correct_information",
        "confirm",
        "reject",
        "ask_question",
        "other"
      ],
      "title": "UserIntent",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "user_intent": {
      "$ref": "#/$defs/UserIntent"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "title": "Operations",
      "type": "array"
    },
    "participants_mentioned": {
      "$ref": "#/$defs/ParticipantsMentioned"
    },
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/Ambiguity"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/Conflict"
      },
      "title": "Conflicts",
      "type": "array"
    }
  },
  "required": [
    "user_intent",
    "operations",
    "participants_mentioned",
    "ambiguities",
    "conflicts"
  ],
  "title": "RequirementPatch",
  "type": "object"
}
