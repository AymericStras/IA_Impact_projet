{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sncf-lio-chatbot/contracts/requirements.schema.json",
  "description": "Payload handed to the planning module after explicit confirmation.",
  "$defs": {
    "CompleteRequirements": {
      "additionalProperties": false,
      "properties": {
        "participants_count": {
          "minimum": 1,
          "title": "Participants Count",
          "type": "integer"
        },
        "participants_breakdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParticipantsBreakdown"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "departure": {
          "$ref": "#/$defs/DateTimeRequirement"
        },
        "return": {
          "$ref": "#/$defs/DateTimeRequirement"
        },
        "teaching_type": {
          "$ref": "#/$defs/CompleteTeachingType"
        }
      },
      "required": [
        "participants_count",
        "departure",
        "return",
        "teaching_type"
      ],
      "title": "CompleteRequirements",
      "type": "object"
    },
    "CompleteTeachingType": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject"
        },
        "theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Theme"
        }
      },
      "required": [
        "subject",
        "theme"
      ],
      "title": "CompleteTeachingType",
      "type": "object"
    },
    "DateTimeRequirement": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "constraint": {
          "$ref": "#/$defs/TimeConstraint"
        }
      },
      "required": [
        "date",
        "time",
        "constraint"
      ],
      "title": "DateTimeRequirement",
      "type": "object"
    },
    "ParticipantsBreakdown": {
      "additionalProperties": false,
      "properties": {
        "students": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Students"
        },
        "accompanying": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accompanying"
        }
      },
      "title": "ParticipantsBreakdown",
      "type": "object"
    },
    "TimeConstraint": {
      "description": "exact = « à 8 h »; approximate = « vers 8 h »; earliest = « après 8 h »; latest = « avant 17 h ».",
      "enum": [
        "exact",
        "approximate",
        "earliest",
        "latest"
      ],
      "title": "TimeConstraint",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "conversation_id": {
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "status": {
      "const": "confirmed",
      "default": "confirmed",
      "title": "Status",
      "type": "string"
    },
    "timezone": {
      "const": "Europe/Paris",
      "default": "Europe/Paris",
      "title": "Timezone",
      "type": "string"
    },
    "confirmed_at": {
      "description": "ISO 8601 timestamp with offset, e.g. 2026-10-10T14:32:05+02:00",
      "title": "Confirmed At",
      "type": "string"
    },
    "requirements": {
      "$ref": "#/$defs/CompleteRequirements"
    }
  },
  "required": [
    "conversation_id",
    "confirmed_at",
    "requirements"
  ],
  "title": "ConfirmedRequirements",
  "type": "object"
}
