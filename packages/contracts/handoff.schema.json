{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sncf-lio-chatbot/contracts/handoff.schema.json",
  "description": "Final payload for the booking step, which is not part of this project.",
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "start": {
          "description": "Local ISO date-time with offset",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "Local ISO date-time with offset",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "start",
        "end"
      ],
      "title": "Activity",
      "type": "object"
    },
    "CompleteRequirements": {
      "additionalProperties": false,
      "properties": {
        "participants_count": {
          "minimum": 1,
          "title": "Participants Count",
          "type": "integer"
        },
        "participants_breakdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParticipantsBreakdown"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "departure": {
          "$ref": "#/$defs/DateTimeRequirement"
        },
        "return": {
          "$ref": "#/$defs/DateTimeRequirement"
        },
        "teaching_type": {
          "$ref": "#/$defs/CompleteTeachingType"
        }
      },
      "required": [
        "participants_count",
        "departure",
        "return",
        "teaching_type"
      ],
      "title": "CompleteRequirements",
      "type": "object"
    },
    "CompleteTeachingType": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject"
        },
        "theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Theme"
        }
      },
      "required": [
        "subject",
        "theme"
      ],
      "title": "CompleteTeachingType",
      "type": "object"
    },
    "DateTimeRequirement": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "constraint": {
          "$ref": "#/$defs/TimeConstraint"
        }
      },
      "required": [
        "date",
        "time",
        "constraint"
      ],
      "title": "DateTimeRequirement",
      "type": "object"
    },
    "ParticipantsBreakdown": {
      "additionalProperties": false,
      "properties": {
        "students": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Students"
        },
        "accompanying": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accompanying"
        }
      },
      "title": "ParticipantsBreakdown",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "theme_match": {
          "description": "Why this proposal fits the teacher's subject or theme",
          "title": "Theme Match",
          "type": "string"
        },
        "outbound": {
          "$ref": "#/$defs/TrainLeg"
        },
        "return": {
          "$ref": "#/$defs/TrainLeg"
        },
        "activities": {
          "items": {
            "$ref": "#/$defs/Activity"
          },
          "title": "Activities",
          "type": "array"
        },
        "participants_count": {
          "minimum": 1,
          "title": "Participants Count",
          "type": "integer"
        },
        "simulated": {
          "description": "True when produced by the built-in simulation, never real availability",
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "destination",
        "theme_match",
        "outbound",
        "return",
        "activities",
        "participants_count",
        "simulated"
      ],
      "title": "Proposal",
      "type": "object"
    },
    "TimeConstraint": {
      "description": "exact = « à 8 h »; approximate = « vers 8 h »; earliest = « après 8 h »; latest = « avant 17 h ».",
      "enum": [
        "exact",
        "approximate",
        "earliest",
        "latest"
      ],
      "title": "TimeConstraint",
      "type": "string"
    },
    "TrainLeg": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "description": "Line label, e.g. 'liO Toulouse – Carcassonne'. No train number in simulation.",
          "title": "Line",
          "type": "string"
        },
        "from_station": {
          "title": "From Station",
          "type": "string"
        },
        "to_station": {
          "title": "To Station",
          "type": "string"
        },
        "departure": {
          "description": "Local ISO date-time with offset (Europe/Paris)",
          "title": "Departure",
          "type": "string"
        },
        "arrival": {
          "description": "Local ISO date-time with offset (Europe/Paris)",
          "title": "Arrival",
          "type": "string"
        }
      },
      "required": [
        "line",
        "from_station",
        "to_station",
        "departure",
        "arrival"
      ],
      "title": "TrainLeg",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "booking_status": {
      "const": "NOT_RESERVED",
      "default": "NOT_RESERVED",
      "title": "Booking Status",
      "type": "string"
    },
    "requirements": {
      "$ref": "#/$defs/CompleteRequirements"
    },
    "proposal": {
      "$ref": "#/$defs/Proposal"
    },
    "simulated": {
      "title": "Simulated",
      "type": "boolean"
    }
  },
  "required": [
    "conversation_id",
    "requirements",
    "proposal",
    "simulated"
  ],
  "title": "Handoff",
  "type": "object"
}
