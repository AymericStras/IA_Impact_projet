{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sncf-lio-chatbot/contracts/travel_file.schema.json",
  "description": "The travel file given to the teacher once the booking is confirmed.",
  "$defs": {
    "CompleteRequirements": {
      "additionalProperties": false,
      "properties": {
        "participants_count": {
          "minimum": 1,
          "title": "Participants Count",
          "type": "integer"
        },
        "participants_breakdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParticipantsBreakdown"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "departure_station": {
          "description": "Departure station OR city, as the teacher said it. A city means any station of that city: the planner expands it.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Departure Station",
          "type": "string"
        },
        "departure": {
          "$ref": "#/$defs/DateTimeRequirement"
        },
        "return": {
          "$ref": "#/$defs/DateTimeRequirement"
        },
        "teaching_type": {
          "$ref": "#/$defs/CompleteTeachingType"
        }
      },
      "required": [
        "participants_count",
        "departure_station",
        "departure",
        "return",
        "teaching_type"
      ],
      "title": "CompleteRequirements",
      "type": "object"
    },
    "CompleteTeachingType": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject"
        },
        "theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Theme"
        }
      },
      "required": [
        "subject",
        "theme"
      ],
      "title": "CompleteTeachingType",
      "type": "object"
    },
    "DateTimeRequirement": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "time": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Time",
          "type": "string"
        },
        "constraint": {
          "$ref": "#/$defs/TimeConstraint"
        }
      },
      "required": [
        "date",
        "time",
        "constraint"
      ],
      "title": "DateTimeRequirement",
      "type": "object"
    },
    "FeasibilityCheck": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "French label of what was checked",
          "title": "Label",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "ok"
      ],
      "title": "FeasibilityCheck",
      "type": "object"
    },
    "Itinerary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "destination_id": {
          "title": "Destination Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "label": {
          "description": "What distinguishes this option, e.g. « Journée complète »",
          "title": "Label",
          "type": "string"
        },
        "outbound": {
          "$ref": "#/$defs/TrainLeg"
        },
        "return": {
          "$ref": "#/$defs/TrainLeg"
        },
        "activities": {
          "items": {
            "$ref": "#/$defs/TimedActivity"
          },
          "title": "Activities",
          "type": "array"
        },
        "free_minutes": {
          "description": "Time on site not taken by activities or walking",
          "minimum": 0,
          "title": "Free Minutes",
          "type": "integer"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/FeasibilityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "participants_count": {
          "minimum": 1,
          "title": "Participants Count",
          "type": "integer"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "destination_id",
        "title",
        "label",
        "outbound",
        "return",
        "activities",
        "free_minutes",
        "checks",
        "participants_count",
        "simulated"
      ],
      "title": "Itinerary",
      "type": "object"
    },
    "ParticipantsBreakdown": {
      "additionalProperties": false,
      "properties": {
        "students": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Students"
        },
        "accompanying": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accompanying"
        }
      },
      "title": "ParticipantsBreakdown",
      "type": "object"
    },
    "Place": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "walk_minutes": {
          "description": "Walking time from the arrival station",
          "minimum": 0,
          "title": "Walk Minutes",
          "type": "integer"
        },
        "note": {
          "description": "Opening hours, group access, booking conditions — illustrative in simulation",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "title",
        "walk_minutes",
        "note"
      ],
      "title": "Place",
      "type": "object"
    },
    "TimeConstraint": {
      "description": "exact = « à 8 h »; approximate = « vers 8 h »; earliest = « après 8 h »; latest = « avant 17 h ».",
      "enum": [
        "exact",
        "approximate",
        "earliest",
        "latest"
      ],
      "title": "TimeConstraint",
      "type": "string"
    },
    "TimedActivity": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "title",
        "start",
        "end"
      ],
      "title": "TimedActivity",
      "type": "object"
    },
    "TrainLeg": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "description": "Line label. No train number in simulation.",
          "title": "Line",
          "type": "string"
        },
        "from_station": {
          "title": "From Station",
          "type": "string"
        },
        "to_station": {
          "title": "To Station",
          "type": "string"
        },
        "departure": {
          "description": "Local ISO date-time with offset (Europe/Paris)",
          "title": "Departure",
          "type": "string"
        },
        "arrival": {
          "description": "Local ISO date-time with offset (Europe/Paris)",
          "title": "Arrival",
          "type": "string"
        }
      },
      "required": [
        "line",
        "from_station",
        "to_station",
        "departure",
        "arrival"
      ],
      "title": "TrainLeg",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reference": {
      "title": "Reference",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "requirements": {
      "$ref": "#/$defs/CompleteRequirements"
    },
    "itinerary": {
      "$ref": "#/$defs/Itinerary"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/Place"
      },
      "title": "Places",
      "type": "array"
    },
    "schedule": {
      "description": "French lines of the day's timetable",
      "items": {
        "type": "string"
      },
      "title": "Schedule",
      "type": "array"
    },
    "safety_advice": {
      "items": {
        "type": "string"
      },
      "title": "Safety Advice",
      "type": "array"
    },
    "useful_contacts": {
      "items": {
        "type": "string"
      },
      "title": "Useful Contacts",
      "type": "array"
    },
    "official_links": {
      "description": "Empty in simulation: real links come from the real modules",
      "items": {
        "type": "string"
      },
      "title": "Official Links",
      "type": "array"
    },
    "simulated": {
      "title": "Simulated",
      "type": "boolean"
    }
  },
  "required": [
    "reference",
    "title",
    "requirements",
    "itinerary",
    "places",
    "schedule",
    "safety_advice",
    "useful_contacts",
    "official_links",
    "simulated"
  ],
  "title": "TravelFile",
  "type": "object"
}
