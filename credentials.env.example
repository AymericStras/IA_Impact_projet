# Copy to credentials.env (never committed) and fill in, or unzip the private
# bundle from the project owner at the project root: it contains this file
# ready to use, and the real logo.
#
# One NAME=value per line, no quotes needed, no shell syntax. A variable set in
# the shell wins over this file.

# Key every caller sends in the X-Bilan-Key header. The owner's bundle carries
# the key of the hosted service, so the same key works locally and hosted.
BILAN_API_KEY=change-me

# Resend key allowed to send from zhaoyang.fr. Needed only for live sending.
RESEND_API_KEY=re_xxxxxxxx

# dry-run: emails are written to var/outbox/<id>.eml, nothing leaves the machine.
# live:    emails are sent.
BILAN_MAIL_MODE=dry-run

# Optional
# BILAN_REPLY_TO=contact@example.fr
# BILAN_ALLOWED_DOMAINS=example.fr,school.fr
# Blind copy of every email to these addresses (the team follows the demo):
# BILAN_COPY_TO=a@example.fr,b@example.fr
# BILAN_DAILY_LIMIT=80
# BILAN_RECIPIENT_DAILY_LIMIT=5
# BILAN_RETENTION_DAYS=30
# BILAN_MAIL_FROM=Sorties scolaires liO – démo <sorties@zhaoyang.fr>
# BILAN_SENDER_NAME=L'équipe Sorties scolaires liO
# BILAN_DATA_DIR=var
