# Copy to credentials.env (never committed) and fill in. One NAME=value per line,
# no quotes needed, no shell syntax. A variable set in the shell wins over this file.

# Key every caller sends in the X-Rapport-Key header. Required in live mode.
RAPPORT_API_KEY=change-me

# Resend key allowed to send from zhaoyang.fr. Needed only for live sending.
RESEND_API_KEY=re_xxxxxxxx

# dry-run: emails are written to var/outbox/<id>.eml, nothing leaves the machine.
# live:    emails are sent.
RAPPORT_MAIL_MODE=dry-run

# Optional: the generated "educational value" texts (see docs/INTEGRATION.md).
# OPENAI_API_KEY=sk-...

# Optional
# RAPPORT_REPLY_TO=contact@example.fr
# RAPPORT_ALLOWED_DOMAINS=example.fr,school.fr
# Blind copy of every email to these addresses (the team follows the demo):
# RAPPORT_COPY_TO=a@example.fr,b@example.fr
# RAPPORT_DAILY_LIMIT=80
# RAPPORT_RECIPIENT_DAILY_LIMIT=5
# RAPPORT_RETENTION_DAYS=30
# RAPPORT_MAIL_FROM=Sorties scolaires liO – démo <sorties@zhaoyang.fr>
# RAPPORT_SENDER_NAME=L'équipe Sorties scolaires liO
# RAPPORT_DATA_DIR=var
