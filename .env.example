# Copy to .env (git-ignored). On the dev Mac, OPENAI_API_KEY is injected by ./tools/with-api-env
# from the macOS Keychain and MUST NOT be written here. Set it only on other hosts / CI secrets.

# --- services/api ---
# OPENAI_API_KEY=            # never commit; injected at runtime on the dev Mac
TRANSCRIPTION_MODEL=gpt-transcribe
EXTRACTION_MODEL=gpt-5.4-mini
APP_TIMEZONE=Europe/Paris
DATABASE_URL=sqlite+aiosqlite:///./.local/dev.db
# DATABASE_URL=postgresql+asyncpg://sncf:sncf@localhost:5433/sncf_chatbot   # docker compose
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MAX_AUDIO_SECONDS=120
MAX_AUDIO_BYTES=10485760
LLM_TIMEOUT_SECONDS=30
AUDIO_RETENTION=none          # audio is transcribed then discarded
LOG_LEVEL=INFO

# --- apps/web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=false   # true = mock conversation, no backend, clearly labelled "Démo"
