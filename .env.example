# Copier en .env (ignoré par Git). Sur le Mac de développement, OPENAI_API_KEY est injectée par
# ./tools/with-api-env depuis le trousseau macOS et NE DOIT PAS être écrite ici. À définir seulement
# sur d'autres hôtes / dans les secrets CI.

# --- services/api ---
# OPENAI_API_KEY=            # jamais committée ; injectée à l'exécution sur le Mac de dev
TRANSCRIPTION_MODEL=gpt-transcribe
EXTRACTION_MODEL=gpt-5.4-mini
EXTRACTION_REASONING_EFFORT=low
APP_TIMEZONE=Europe/Paris
DATABASE_URL=sqlite:///./.local/dev.db
# DATABASE_URL=postgresql+psycopg://sncf:sncf@localhost:5433/sncf_chatbot   # docker compose
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MAX_AUDIO_SECONDS=120
MAX_AUDIO_BYTES=10485760
LLM_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

# --- apps/web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=false   # true = conversation simulée, sans backend, badge « Mode démo »
