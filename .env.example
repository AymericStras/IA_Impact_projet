# Copy to .env (ignored by Git). On the development Mac, OPENAI_API_KEY is injected by
# ./tools/with-api-env from the macOS Keychain and MUST NOT be written here. Set it only
# on other hosts / in CI secrets.

# --- services/api ---
# OPENAI_API_KEY=            # never committed; injected at runtime on the dev Mac
TRANSCRIPTION_MODEL=gpt-transcribe
EXTRACTION_MODEL=gpt-5.4-mini
EXTRACTION_REASONING_EFFORT=low
APP_TIMEZONE=Europe/Paris
DATABASE_URL=sqlite:///./.local/dev.db
# DATABASE_URL=postgresql+psycopg://sncf:sncf@localhost:5433/sncf_chatbot   # docker compose
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MAX_AUDIO_SECONDS=120
MAX_AUDIO_BYTES=10485760
LLM_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

# --- apps/web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=false   # true = simulated conversation, no backend, « Mode démo » badge
