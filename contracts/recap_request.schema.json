{
  "$defs": {
    "Leg": {
      "additionalProperties": false,
      "properties": {
        "from_station": {
          "maxLength": 80,
          "minLength": 1,
          "title": "From Station",
          "type": "string"
        },
        "to_station": {
          "maxLength": 80,
          "minLength": 1,
          "title": "To Station",
          "type": "string"
        },
        "departure": {
          "format": "date-time",
          "title": "Departure",
          "type": "string"
        },
        "arrival": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "line": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "train_number": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Number"
        },
        "coach": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coach"
        },
        "seat": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat"
        }
      },
      "required": [
        "from_station",
        "to_station",
        "departure"
      ],
      "title": "Leg",
      "type": "object"
    },
    "Recipient": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "email"
      ],
      "title": "Recipient",
      "type": "object"
    },
    "Trip": {
      "additionalProperties": false,
      "description": "The price is not part of the input: it is a fixed tariff, see view.PRICE_PER_PERSON_CENTS.",
      "properties": {
        "reference": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "participants_count": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Participants Count",
          "type": "integer"
        },
        "travel_class": {
          "anyOf": [
            {
              "enum": [
                "1",
                "2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Travel Class"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/Leg"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Legs",
          "type": "array"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "participants_count",
        "legs"
      ],
      "title": "Trip",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "recipient": {
      "$ref": "#/$defs/Recipient"
    },
    "trip": {
      "$ref": "#/$defs/Trip"
    },
    "locale": {
      "const": "fr",
      "default": "fr",
      "title": "Locale",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "idempotency_key",
    "recipient",
    "trip"
  ],
  "title": "RecapRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
