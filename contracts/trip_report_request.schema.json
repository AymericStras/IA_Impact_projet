            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        }
      },
      "title": "Activity",
      "type": "object"
    },
    "Competencies": {
      "properties": {
        "savoir": {
          "$ref": "#/$defs/Competency"
        },
        "savoir_faire": {
          "$ref": "#/$defs/Competency"
        },
        "savoir_se_deplacer": {
          "$ref": "#/$defs/Competency"
        },
        "savoir_s_orienter": {
          "$ref": "#/$defs/Competency"
        },
        "savoir_etre": {
          "$ref": "#/$defs/Competency"
        }
      },
      "title": "Competencies",
      "type": "object"
    },
    "Competency": {
      "properties": {
        "status": {
          "default": "non_evalue",
          "enum": [
            "acquis",
            "partiel",
            "non_evalue"
          ],
