            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "taken_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taken At"
        },
        "consent": {
          "default": false,
          "title": "Consent",
          "type": "boolean"
        },
        "kind": {
          "default": "trip",
          "enum": [
            "trip",
            "documentary"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Photo",
      "type": "object"
    },
    "Place": {
      "properties": {
        "title": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
