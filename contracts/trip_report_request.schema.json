    "Trip": {
      "properties": {
        "reference": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 160,
