          "default": null,
          "title": "Theme"
        },
        "objectives": {
          "items": {
            "type": "string"
          },
          "title": "Objectives",
          "type": "array"
        },
        "places": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "title": "Places",
          "type": "array"
        },
        "activities": {
          "items": {
            "$ref": "#/$defs/Activity"
          },
          "title": "Activities",
          "type": "array"
        },
        "insights": {
          "anyOf": [
            {
              "$ref": "#/$defs/Insights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Education",
      "type": "object"
    },
    "Environment": {
      "properties": {
        "baselines": {
          "items": {
            "enum": [
              "autocar",
              "voiture"
            ],
            "type": "string"
          },
          "title": "Baselines",
          "type": "array"
        },
        "distance_km_override": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Km Override"
        },
        "car_occupancy": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Car Occupancy"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "Insights": {
      "description": "Short texts on the educational value of the trip.\n\nWritten by `enrich.py` with a language model, or supplied by the caller.\nThey describe what the trip let the class work on; they never state a\nresult, which only `teacher_feedback.competencies` does.",
      "properties": {
        "why": {
          "anyOf": [
            {
              "maxLength": 700,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        },
        "competencies": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompetencyInsights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        },
        "origin": {
          "default": "ai",
          "enum": [
            "ai",
            "teacher"
          ],
          "title": "Origin",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "reviewed_by_teacher": {
          "default": false,
          "title": "Reviewed By Teacher",
          "type": "boolean"
        }
      },
      "title": "Insights",
      "type": "object"
    },
    "Media": {
      "properties": {
        "photos": {
          "items": {
            "$ref": "#/$defs/Photo"
          },
          "title": "Photos",
          "type": "array"
        }
      },
      "title": "Media",
      "type": "object"
    },
    "Participants": {
      "properties": {
        "total": {
          "anyOf": [
            {
              "maximum": 2000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "students": {
          "anyOf": [
            {
              "maximum": 2000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Students"
        },
        "accompanying": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accompanying"
        }
      },
      "title": "Participants",
      "type": "object"
    },
